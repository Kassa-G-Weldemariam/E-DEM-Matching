# Application
PROJECT_NAME=E-DEM Matching
API_V1_STR=/v1

# Database
DATABASE_URL=postgresql+psycopg://postgresuser:password@localhost:5433/db_name
TEST_DATABASE_URL=postgresql+psycopg://postgresuser:password@localhost:5433/db_name_test

# JWT Authentication
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis (for background jobs with ARQ)
REDIS_URL=redis://localhost:6379/0

# Matching parameters 
BLOOD_BANK_RESPONSE_TIMEOUT_MINUTES=15
DONOR_RESPONSE_TIMEOUT_MINUTES=10
MAX_MATCHING_RADIUS_KM=25.0
DONORS_PER_BATCH=5
MAX_BATCHES=3
MIN_DAYS_BETWEEN_DONATIONS=56